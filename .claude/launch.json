{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pip-backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "sispoa-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend/sispoa && exec ./node_modules/.bin/ng serve --project sispoa --host 127.0.0.1"
      ],
      "port": 4200
    }
  ]
}
